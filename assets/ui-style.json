{
  "styles": {
    ".body": {
      "text": {
        "color": "$text",
        "size": 16
      }
    },
    ".muted": {
      "text": {
        "color": "$muted",
        "size": 16
      }
    },
    ".small": {
      "text": {
        "color": "$muted",
        "size": 14.4
      }
    },
    ".tiny": {
      "text": {
        "color": "$muted",
        "size": 12
      }
    },
    ".title": {
      "text": {
        "color": "$accent",
        "size": 41.6,
        "weight": "700",
        "letterSpacing": 0.8
      }
    },
    ".title-glow": {
      "text": {
        "color": "$accent",
        "size": 41.6,
        "weight": "700",
        "letterSpacing": 0.8,
        "shadow": {
          "blur": 18,
          "color": "#e8a04c55"
        }
      }
    },
    ".h2": {
      "text": {
        "color": "$text",
        "size": 24,
        "weight": "700"
      }
    },
    ".h3": {
      "text": {
        "color": "$text",
        "size": 18.7,
        "weight": "700"
      }
    },
    ".strong": {
      "text": {
        "color": "$text",
        "size": 16,
        "weight": "700"
      }
    },
