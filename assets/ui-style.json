      "text": {
        "color": "$accent",
        "size": 24,
        "weight": "700"
      }
    },
    ".achievements": {
      "text": {
        "color": "$accent-2",
        "size": 16,
        "weight": "700"
      }
    },
    ".score-th": {
      "text": {
        "color": "$muted",
        "size": 13.6
      }
    },
    ".score-row": {
      "border": {
        "width": {
          "bottom": 1
        },
        "color": {
          "bottom": "#ffffff14"
        },
        "style": "solid"
      },
      "padding": {
        "top": 6,
        "end": 0,
        "bottom": 6,
        "start": 0
      }
    },
