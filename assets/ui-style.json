      "padding": {
        "top": 10,
        "end": 18,
        "bottom": 10,
        "start": 18
      },
      "text": {
        "color": "$text",
        "size": 16
      }
    },
    ".btn": {
      "background": "$panel-2",
      "border": {
        "width": 1,
        "color": "#00000066",
        "style": "solid"
      },
      "radius": 10,
      "padding": {
        "top": 10,
        "end": 18,
        "bottom": 10,
        "start": 18
      },
      "minWidth": 44,
      "minHeight": 44,
      "text": {
        "color": "$text",
        "size": 16,
        "align": "center"
      },
      "hovered": {
        "background": "#3a2d22"
      },
      "focusVisible": {
        "focusRing": {
          "width": 3,
          "color": "$focus",
          "offset": 2
        }
      },
      "disabled": {
        "opacity": 0.45
      }
    },
    ".primary": {
      "background": "$accent",
      "border": {
        "width": 1,
        "color": "#00000066",
        "style": "solid"
      },
      "radius": 10,
      "padding": {
        "top": 10,
        "end": 18,
        "bottom": 10,
        "start": 18
      },
      "minWidth": 44,
      "minHeight": 44,
      "text": {
        "color": "#1d1208",
        "size": 16,
        "weight": "700",
        "align": "center"
      },
      "hovered": {
        "background": "#f0b060"
      },
      "focusVisible": {
        "focusRing": {
          "width": 3,
          "color": "$focus",
          "offset": 2
        }
      },
      "disabled": {
        "opacity": 0.45
      }
