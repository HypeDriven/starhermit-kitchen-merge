      "background": "$panel-2",
      "border": {
        "width": {
          "start": 4
        },
        "color": {
          "start": "$danger"
        },
        "style": "solid"
      },
      "radius": 10,
      "padding": {
        "top": 8,
        "end": 10,
        "bottom": 8,
        "start": 10
      }
    },
