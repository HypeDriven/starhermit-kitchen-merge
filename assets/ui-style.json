      "text": {
        "color": "$muted",
        "size": 16
      }
    },
    ".title-card": {
      "background": "#241b14e6",
      "border": {
        "width": 1,
        "color": "$edge",
        "style": "solid"
      },
      "radius": 14,
      "shadow": {
        "y": 10,
        "blur": 40,
        "color": "#00000099"
      },
      "padding": {
        "top": 24,
        "end": 28,
        "bottom": 24,
        "start": 28
      }
    },
    ".panel": {
      "background": "$panel",
      "border": {
        "width": 1,
        "color": "$edge",
        "style": "solid"
      },
      "radius": 14,
      "shadow": {
        "y": 10,
        "blur": 40,
        "color": "#00000099"
      },
      "padding": {
        "top": 24,
        "end": 28,
        "bottom": 24,
        "start": 28
      }
    },
    ".panel-lit": {
      "background": {
        "type": "linear",
        "stops": [
          "#2b221b",
          {
            "color": "#241b14",
            "at": 0.4
          }
        ]
      },
      "border": {
        "width": 1,
        "color": "$edge",
        "style": "solid"
      },
      "radius": 14,
      "shadow": {
        "y": 10,
        "blur": 40,
        "color": "#00000099"
      },
      "padding": {
        "top": 24,
        "end": 28,
        "bottom": 24,
        "start": 28
      }
    },
    ".hud": {
      "background": "$panel",
      "padding": {
        "top": 8,
        "end": 12,
        "bottom": 8,
        "start": 12
      }
    },
    ".rail": {
      "background": "$panel",
      "radius": 12,
      "padding": 10
    },
    ".rail-title": {
      "text": {
        "color": "$muted",
        "size": 13.6,
        "weight": "700",
        "letterSpacing": 1.1
      }
    },
    ".hud-title": {
      "text": {
        "color": "$text",
        "size": 16,
        "weight": "700"
      }
    },
    ".hud-timer": {
      "text": {
        "color": "$muted",
        "size": 16
      }
    },
    ".hud-urgent": {
      "text": {
        "color": "$danger",
        "size": 16,
        "weight": "700"
      }
    },
    ".hud-score": {
      "text": {
        "color": "$accent",
        "size": 20.8,
        "weight": "700"
      }
    },
    ".pill": {
      "background": "$accent-2",
      "radius": 99,
      "padding": {
        "top": 2,
        "end": 8,
        "bottom": 2,
        "start": 8
      },
      "text": {
        "color": "#10240f",
        "size": 12
      }
    },
